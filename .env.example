# EVM (Ethereum Sepolia) — required for evm2sol sends and the receiver deploy
EVM_PRIVATE_KEY=your_private_key_here
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Solana Devnet — defaults to the public RPC and ~/.config/solana/id.json if unset
SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_WALLET_PATH=/Users/you/.config/solana/id.json

# Your deployed BasicCCIPReceiver on Sepolia (run: npm run evm:receiver:deploy)
EVM_RECEIVER_ADDRESS=0x...

# For the Anchor integration test (tests/chainlink-solana-demo-int-test.ts)
# ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
# ANCHOR_WALLET=/Users/you/.config/solana/id.json