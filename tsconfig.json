{
  "compilerOptions": {
    "types": ["mocha", "node"],
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true
  },
  "include": ["read-data.ts", "ccip-scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "target", "contracts"]
}
