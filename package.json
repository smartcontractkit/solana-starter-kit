{
  "name": "solana-starter-kit",
  "version": "0.1.0",
  "description": "Solana starter kit with Chainlink CCIP 2.0 (ccip-sdk), Data Feeds, and example Anchor programs",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "read-data": "tsx read-data.ts",
    "type-check": "tsc --noEmit",
    "svm:program:build": "anchor build",
    "svm:program:deploy": "tsx ccip-scripts/program/deploy.ts",
    "svm:receiver-v2:setup": "tsx ccip-scripts/program/setup-receiver-v2.ts",
    "svm:sender-v2:setup": "tsx ccip-scripts/program/setup-sender-v2.ts",
    "svm:receiver-v2:status": "tsx ccip-scripts/program/status.ts",
    "sol2evm:fee": "tsx ccip-scripts/sol2evm/check-fee.ts",
    "sol2evm:data": "tsx ccip-scripts/sol2evm/send-data.ts",
    "sol2evm:token": "tsx ccip-scripts/sol2evm/send-token.ts",
    "sol2evm:data-and-token": "tsx ccip-scripts/sol2evm/send-data-and-token.ts",
    "evm2sol:fee": "tsx ccip-scripts/evm2sol/check-fee.ts",
    "evm2sol:data": "tsx ccip-scripts/evm2sol/send-data.ts",
    "evm2sol:token": "tsx ccip-scripts/evm2sol/send-token.ts",
    "evm2sol:data-and-token": "tsx ccip-scripts/evm2sol/send-data-and-token.ts",
    "evm2sol:manual-execute": "tsx ccip-scripts/evm2sol/manual-execute.ts",
    "sol2evm:manual-execute": "tsx ccip-scripts/sol2evm/manual-execute.ts",
    "evm:receiver:deploy": "tsx ccip-scripts/evm/deploy-receiver.ts",
    "evm:receiver:config": "tsx ccip-scripts/evm/set-receiver-config.ts",
    "svm:sender-v2:config": "tsx ccip-scripts/program/update-sender-chain-config.ts",
    "svm:cleanup": "tsx ccip-scripts/program/cleanup-buffers.ts",
    "balance": "tsx ccip-scripts/balance.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@chainlink/ccip-sdk": "^1.18.0",
    "@chainlink/contracts-ccip": "^2.0.0",
    "@chainlink/solana-sdk": "^0.2.2",
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.3.11",
    "@solana/web3.js": "^1.99.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/mocha": "^9.0.0",
    "@types/node": "^22.10.0",
    "@types/yargs": "^17.0.33",
    "mocha": "^10.8.2",
    "prettier": "^3.10.1",
    "ts-mocha": "^10.1.0"
  },
  "overrides": {
    "@solana/web3.js": "^1.99.0",
    "zod": "^4.6.7",
    "minimatch": "^3.1.5",
    "brace-expansion": "^2.0.0",
    "picomatch": "^3.0.0",
    "tmp": "^0.2.5",
    "@openzeppelin/contracts": "4.9.6",
    "@openzeppelin/contracts-upgradeable": "4.9.6",
    "@openzeppelin/contracts-4.7.3": "npm:@openzeppelin/contracts@4.9.6"
  }
}
